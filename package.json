{
  "name": "pace-environmental-observatory",
  "version": "1.10.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "tsc --noEmit && eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0 && prettier -c \"**/*.{js,jsx,ts,tsx}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx}\" --write",
    "test": "npm run lint && npx cspell . && npm audit --audit-level=low && npx expo-doctor"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-orientation-locker",
          "react-native-navigation-bar",
          "react-navigation",
          "react-navigation-stack",
          "tailwindcss",
          "@babel/core"
        ]
      }
    }
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "2.99.1",
    "@tanstack/react-query": "5.90.3",
    "@types/react": "19.0.10",
    "axios": "1.18.1",
    "babel-preset-expo": "~57.0.0",
    "date-fns": "4.1.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lottie-react-native": "7.4.0",
    "nativewind": "4.2.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-picker-select": "9.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "4.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "victory-native": "41.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "cspell": "9.2.1",
    "eslint": "9.32.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-import-resolver-typescript": "4.4.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.5.14",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.0",
    "xcode": {
      "uuid": "^14.0.1"
    }
  },
  "private": false,
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true
  }
}
